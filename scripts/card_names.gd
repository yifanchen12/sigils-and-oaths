static func for_rules(cards: Array[Dictionary]) -> Array[Dictionary]:
	var canonical: Array[Dictionary] = []
	for card: Dictionary in cards:
		var copy: Dictionary = card.duplicate(true)
		if PREVIOUS.has(copy.id): copy.name = PREVIOUS[copy.id]
		canonical.append(copy)
	return canonical

static func display_text(value: String) -> String:
	# Preset descriptions are part of historical save signatures; translate only
	# their displayed references, keeping the saved rule metadata byte-for-byte.
	var catalog = load("res://data/cards.tres")
	for card: Dictionary in catalog.cards:
		var previous: String = PREVIOUS.get(card.id, "")
		if not previous.is_empty(): value = value.replace(previous, card.name)
	return value
