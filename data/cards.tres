[gd_resource type="Resource" script_class="CardData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/card_data.gd" id="1"]

[resource]
script = ExtResource("1")
cards = Array[Dictionary]([{
"id": "sword", "name": "誓约步兵", "short": "步", "type": "unit", "kind": "sword", "cost": 1,
"atk": 3, "hp": 5, "defense": 1, "move": 2, "range": 1,
"skill": {"name": "誓约坚守", "cost": 1, "text": "自身护盾至少变为3，不叠加。结束移动与攻击。"},
"text": "森林移动费用仅 1。\n克制枪兵，伤害 +2。", "tag": "步兵 · 前线"
}, {
"id": "spear", "name": "铁壁枪卫", "short": "枪", "type": "unit", "kind": "spear", "cost": 2,
"atk": 3, "hp": 7, "defense": 2, "move": 2, "range": 1,
"skill": {"name": "铁壁援护", "cost": 1, "text": "至下次己方回合，替上下左右相邻友军承受普通攻击。定身时不能接应；不拦法术。结束行动。"},
"text": "本回合未移动时防御 +1。\n森林费用 1，克骑兵伤害 +2。", "tag": "枪兵 · 防御"
}, {
"id": "cavalry", "name": "逐风骑士", "short": "骑", "type": "unit", "kind": "cavalry", "cost": 3,
"atk": 5, "hp": 5, "defense": 0, "move": 4, "range": 1,
"skill": {"name": "疾风再动", "cost": 1, "text": "已移动、未攻击时，再移动最多2点地形费用。保留攻击机会；定身不可用。"},
"text": "本回合移动至少 3 格，攻击 +1。\n军道出发移动 +1，克步兵。", "tag": "骑兵 · 机动"
}, {
"id": "archer", "name": "暮林游侠", "short": "弓", "type": "unit", "kind": "archer", "cost": 2,
"atk": 3, "hp": 4, "defense": 0, "move": 2, "range": 3,
"skill": {"name": "精准射击", "cost": 1, "text": "按普通攻击射程攻击，伤害+1，仍受援护与反击。结束行动。"},
"text": "射程 3 格，高地再 +1。\n攻击相邻敌军时伤害 -1。", "tag": "弓手 · 远程"
}, {
"id": "mage", "name": "星火术士", "short": "法", "type": "unit", "kind": "mage", "cost": 4,
"atk": 5, "hp": 4, "defense": 0, "move": 2, "range": 2,
"skill": {"name": "星火迸发", "cost": 1, "text": "自身2格内一名敌军受到3火焰伤害，受天气影响，无视防御。结束行动。"},
"text": "射程 2 格，攻击无视 1 防御。\n生命较低，需要友军保护。", "tag": "法师 · 爆发"
}, {
"id": "healer", "name": "晨光医师", "short": "医", "type": "unit", "kind": "healer", "cost": 3,
"atk": 2, "hp": 5, "defense": 0, "move": 2, "range": 2,
"skill": {"name": "战地急救", "cost": 1, "text": "治疗自身2格内一名受伤友军3生命。结束移动与攻击。"},
"text": "己方回合开始时，治疗\n自身及相邻友军 1 点生命。", "tag": "治疗兵 · 支援"
}, {
"id": "bolt", "name": "星火箭", "short": "焰", "type": "spell", "effect": "damage", "cost": 2, "amount": 4,
"text": "对一名敌军造成 4 点伤害。\n无视防御，护盾可以抵挡。", "tag": "法术 · 单体"
}, {
"id": "nova", "name": "陨火之环", "short": "环", "type": "spell", "effect": "area", "cost": 4, "amount": 3,
"text": "对目标敌军及其上下左右\n相邻敌军造成 3 点伤害。", "tag": "法术 · 范围"
}, {
"id": "heal", "name": "晨曦祷言", "short": "愈", "type": "spell", "effect": "heal", "cost": 2, "amount": 5,
"text": "为一名受伤友军恢复\n5 点生命，不超过生命上限。", "tag": "法术 · 治疗"
}, {
"id": "ward", "name": "磐石护盾", "short": "盾", "type": "spell", "effect": "shield", "cost": 1, "amount": 3,
"text": "使一名友军获得 3 点护盾。\n不叠加，持续到被伤害耗尽。", "tag": "法术 · 防护"
}, {
"id": "march", "name": "疾行军令", "short": "行", "type": "spell", "effect": "march", "cost": 1, "amount": 1,
"text": "使已移动、未攻击的部队\n再次移动。不能用于新兵。", "tag": "法术 · 机动"
}, {
"id": "insight", "name": "战地谋略", "short": "策", "type": "spell", "effect": "draw", "cost": 2, "amount": 2,
"text": "抽 2 张牌。\n手牌最多 8 张，超出则弃置。", "tag": "法术 · 补给"
}, {
"id": "rain", "name": "骤雨将至", "short": "雨", "type": "environment", "effect": "weather", "weather": "rain", "cost": 2, "duration": 4,
"text": "暴雨持续 4 个行动回合。\n骑兵在军道外移动费用 +1，\n所有火焰法术伤害 -1。", "tag": "环境 · 暴雨"
}, {
"id": "fog", "name": "迷雾帷幕", "short": "雾", "type": "environment", "effect": "weather", "weather": "fog", "cost": 2, "duration": 4,
"text": "浓雾持续 4 个行动回合。\n双方远程单位的最终射程\n最多为 2 格。", "tag": "环境 · 浓雾"
}, {
"id": "sun", "name": "烈日天穹", "short": "日", "type": "environment", "effect": "weather", "weather": "sun", "cost": 2, "duration": 4,
"text": "烈日持续 4 个行动回合。\n双方火焰法术伤害 +1，\n治疗兵的回合治疗 +1。", "tag": "环境 · 烈日"
}, {
"id": "snow", "name": "凛冬寒潮", "short": "雪", "type": "environment", "effect": "weather", "weather": "snow", "cost": 3, "duration": 4,
"text": "寒潮持续 4 个行动回合。\n双方部队移动力 -1（最低 1），\n森林额外提供 1 防御。", "tag": "环境 · 寒潮"
}, {
"id": "rampart", "name": "战地工事", "short": "垒", "type": "spell", "effect": "terrain", "terrain": "fort", "cost": 2,
"text": "将一名友军脚下的地形\n改为永久工事，提供 2 防御。\n不能覆盖桥梁。", "tag": "地理 · 工事"
}, {
"id": "trail", "name": "开辟军道", "short": "道", "type": "spell", "effect": "terrain", "terrain": "road", "cost": 1,
"text": "将一处非山地、非河流、\n非桥梁地形改为军道。\n军道骑兵移动力 +1。", "tag": "地理 · 军道"
}, {
"id": "initiative", "name": "战术先机", "short": "势", "type": "tactic", "effect": "mana", "cost": 0, "amount": 1, "generated_only": true,
"text": "获得 1 点本回合临时法力。\n后手专属，仅获得一次。\n法力最多为 10。", "tag": "谋略 · 后手补偿"
}, {
"id": "repulse", "name": "破阵冲击", "short": "退", "type": "spell", "effect": "repulse", "cost": 2, "amount": 2,
"text": "对非指挥官敌军造成 2 伤害，\n并向远离己方指挥官方向击退 1 格。\n后方受阻时改为 3 伤害。", "tag": "战术 · 击退"
}, {
"id": "frostbind", "name": "坚冰锁链", "short": "锁", "type": "spell", "effect": "root", "cost": 2,
"text": "使一名非指挥官敌军在其\n下个己方回合无法移动。\n仍可攻击，强制位移不受影响。", "tag": "战术 · 定身"
}, {
"id": "dispel", "name": "破咒之印", "short": "散", "type": "spell", "effect": "dispel", "cost": 1,
"text": "移除一名敌军的全部护盾。\n可用于敌方指挥官。", "tag": "战术 · 驱散"
}, {
"id": "exchange", "name": "移形军令", "short": "换", "type": "spell", "effect": "exchange", "cost": 2,
"text": "一名友军与己方指挥官\n交换位置，行动状态保持不变。\n可用于被定身的部队。", "tag": "战术 · 换位"
}, {
"id": "onslaught", "name": "乘势追击", "short": "追", "type": "spell", "effect": "onslaught", "cost": 3,
"text": "令一名本回合已攻击的部队\n再次获得攻击机会。\n不恢复移动，不能用于新兵或指挥官。", "tag": "战术 · 追击"
}, {
"id": "clear_skies", "name": "晴空号令", "short": "晴", "type": "environment", "effect": "clear_weather", "cost": 1,
"text": "立即驱散当前天气，\n使战场恢复晴朗。\n晴朗时不能使用。", "tag": "环境 · 驱散"
}, {
"id": "shatter_bolt", "name": "破阵谕火", "short": "烬", "type": "spell", "effect": "shatter_bolt", "cost": 3, "amount": 2,
"text": "先移除敌军全部护盾，\n再造成2点火焰伤害。\n受天气与赤烬首发加成影响。", "tag": "法术 · 破盾"
}, {
"id": "rally_heal", "name": "同行祷雨", "short": "祷", "type": "spell", "effect": "rally_heal", "cost": 3, "amount": 2,
"text": "为目标格及相邻四格\n所有友军恢复2生命。\n不会恢复行动次数。", "tag": "法术 · 群疗"
}, {
"id": "cleanse_root", "name": "净途符", "short": "净", "type": "spell", "effect": "cleanse_root", "cost": 1, "amount": 1,
"text": "解除一名友军的定身，\n并恢复1生命。\n不会重置已经消耗的行动。", "tag": "法术 · 解缚"
}, {
"id": "reveal_traps", "name": "寻痕灯", "short": "探", "type": "spell", "effect": "reveal_traps", "cost": 1,
"text": "探查目标格及相邻四格，\n拆除范围内的敌方陷阱。\n空查仍消耗此牌与法力。", "tag": "法术 · 反伏设"
}, {
"id": "seedwood", "name": "林息落种", "short": "林", "type": "environment", "effect": "terrain", "terrain": "forest", "cost": 2,
"text": "将施法范围内一格改为森林。\n提供防御，并改变移动费用。\n不能覆盖山地、河流或桥梁。", "tag": "环境 · 植林"
}, {
"id": "anchor_snare", "name": "锚索伏阵", "short": "缚", "type": "trap", "effect": "trap", "trigger": "step", "cost": 2, "amount": 1, "root": true,
"text": "伏设空格。敌军主动踏入时，\n造成1伤害并中断移动，\n本回合定身。触发后弃置。", "tag": "陷阱 · 地格 / 缚足"
}, {
"id": "ember_mine", "name": "余烬地雷", "short": "雷", "type": "trap", "effect": "trap", "trigger": "step", "cost": 3, "amount": 3, "fire": true,
"text": "伏设空格。敌军主动踏入时，\n造成3点火焰伤害，受天气影响。\n无指挥官加成，触发后弃置。", "tag": "陷阱 · 地格 / 爆破"
}, {
"id": "oath_ward", "name": "回誓屏障", "short": "誓", "type": "trap", "effect": "trap", "trigger": "attack", "cost": 2, "amount": 3,
"text": "伏设于友军。下次实际承受\n普攻前获得3护盾（上限5）。\n随其移动，触发后弃置。", "tag": "陷阱 · 受击反制"
}, {
"id": "span_kit", "name": "临桥木架", "short": "桥", "type": "spell", "effect": "terrain", "terrain": "bridge", "cost": 3,
"text": "在友军施法范围内，将一格\n邻接可通行地面的河流架为桥。\n桥梁永久留在战场，可接续架设。", "tag": "法术 · 临桥"
}, {
"id": "countercurrent_ward", "name": "回流护印", "short": "护", "type": "trap", "effect": "trap", "trigger": "spell", "cost": 2, "amount": 3,
"text": "从手牌伏设于友军。下次实际\n承受敌方伤害法术或技能前获得\n3护盾（上限5）；不防普攻。", "tag": "陷阱 · 术击反制"
}, {
"id": "reed_scout", "name": "芦滩前哨", "short": "步", "type": "unit", "kind": "sword", "cost": 2, "set_id": "warfront",
"hp": 4, "atk": 2, "defense": 0, "move": 3, "range": 1, "entry": {"draw": 1},
"text": "部署时抽1张牌。\n步兵，保留誓约坚守主动。", "tag": "步兵 · 进场抽牌"
}, {
"id": "gate_veteran", "name": "守桥老枪", "short": "枪", "type": "unit", "kind": "spear", "cost": 3, "set_id": "warfront",
"hp": 6, "atk": 2, "defense": 1, "move": 2, "range": 1, "entry": {"guard": true, "self_shield": 1},
"text": "部署时获得1护盾并立即援护\n相邻友军，持续到下个己方回合。", "tag": "枪兵 · 进场援护"
}, {
"id": "ridge_courier", "name": "高岭传令骑", "short": "骑", "type": "unit", "kind": "cavalry", "cost": 4, "set_id": "warfront",
"hp": 6, "atk": 4, "defense": 0, "move": 4, "range": 1, "entry": {"refresh_move": true},
"text": "部署时恢复正交相邻友军的移动。\n仅对已移动、未攻击、可行动的普通部队生效。", "tag": "骑兵 · 进场换步"
}, {
"id": "ridge_archer", "name": "高台破雾弩", "short": "弓", "type": "unit", "kind": "archer", "cost": 5, "set_id": "warfront",
"hp": 5, "atk": 4, "defense": 0, "move": 2, "range": 3, "entry": {"reveal": true},
"text": "部署时拆除落点及正交相邻格\n内的敌方陷阱。", "tag": "弓手 · 进场反伏设"
}, {
"id": "shore_medic", "name": "河岸随军医", "short": "医", "type": "unit", "kind": "healer", "cost": 5, "set_id": "warfront",
"hp": 6, "atk": 2, "defense": 0, "move": 3, "range": 1, "entry": {"healing": 3, "cleanse": true},
"text": "部署时为相邻友军恢复3生命\n并解除定身。", "tag": "医师 · 进场急救"
}, {
"id": "scribe_warden", "name": "星纹抄法师", "short": "法", "type": "unit", "kind": "mage", "cost": 6, "set_id": "warfront",
"hp": 6, "atk": 4, "defense": 0, "move": 2, "range": 3, "entry": {"draw": 2},
"text": "部署时抽2张牌。\n法师可将施法中心延伸到4格。", "tag": "法师 · 进场抽牌"
}, {
"id": "breakwater_guard", "name": "断浪卫长", "short": "步", "type": "unit", "kind": "sword", "cost": 7, "set_id": "warfront",
"hp": 10, "atk": 5, "defense": 1, "move": 2, "range": 1, "entry": {"shield": 2},
"text": "部署时给自身和正交相邻友军\n各增加2护盾，上限5。", "tag": "步兵 · 进场群盾"
}, {
"id": "bronze_watch", "name": "铜门誓卫", "short": "枪", "type": "unit", "kind": "spear", "cost": 9, "set_id": "warfront",
"hp": 11, "atk": 5, "defense": 2, "move": 2, "range": 1, "entry": {"guard": true, "self_shield": 3},
"text": "部署时获得3护盾并立即援护\n相邻友军，持续到下个己方回合。", "tag": "枪兵 · 重装援护"
}, {
"id": "field_signals", "name": "一线微光", "short": "芒", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 1, "shield": 1, "cost": 1, "set_id": "warfront",
"text": "目标格及相邻四格的友军\n各获得1护盾，上限5。", "tag": "法术 · 小范围护盾"
}, {
"id": "detach_line", "name": "解索轮替", "short": "解", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 1, "cleanse": true, "refresh_move": true, "cost": 2, "set_id": "warfront",
"text": "解除目标格及相邻四格友军的定身。\n已移动、未攻击且可行动的普通部队\n同时恢复移动。", "tag": "法术 · 解缚换步"
}, {
"id": "dispatch_bundle", "name": "前线三封信", "short": "札", "type": "spell", "effect": "draw", "amount": 3, "cost": 3, "set_id": "warfront",
"text": "抽3张牌。\n手牌满会弃掉后续抽牌，空牌库仍有疲劳。", "tag": "法术 · 抽牌"
}, {
"id": "mist_spike", "name": "雾棘封径", "short": "棘", "type": "spell", "effect": "formation", "target_side": "enemy", "radius": 1, "damage": 2, "root": true, "cost": 4, "set_id": "warfront",
"text": "目标格及相邻四格敌军受2伤害。\n存活的普通部队下个行动回合无法移动。", "tag": "法术 · 群体定身"
}, {
"id": "kiln_lance", "name": "开窑火矛", "short": "矛", "type": "spell", "effect": "damage", "amount": 7, "cost": 5, "set_id": "warfront",
"text": "对范围内一名敌军造成7火焰伤害。\n受天气和赤烬首发加成影响。", "tag": "法术 · 单体爆发"
}, {
"id": "warder_hymn", "name": "众灯长明", "short": "颂", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 1, "healing": 3, "shield": 2, "cost": 6, "set_id": "warfront",
"text": "目标格及相邻四格友军\n恢复3生命并获得2护盾，上限5。", "tag": "法术 · 群疗加盾"
}, {
"id": "hammer_sweep", "name": "崩纹震击", "short": "震", "type": "spell", "effect": "formation", "target_side": "enemy", "radius": 1, "damage": 3, "clear_shield": true, "cost": 6, "set_id": "warfront",
"text": "先清除目标格及相邻四格敌人的已有护盾，\n再分别造成3点伤害。", "tag": "法术 · 群体破盾"
}, {
"id": "second_watch", "name": "换班再击", "short": "击", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 1, "refresh_attack": true, "cost": 7, "set_id": "warfront",
"text": "目标格及相邻四格已攻击的已就绪部队\n恢复攻击机会。指挥官和新兵除外。\n保持原移动和主动技能状态。", "tag": "法术 · 范围再攻"
}, {
"id": "signal_torrent", "name": "澜潮冲阵", "short": "潮", "type": "spell", "effect": "formation", "target_side": "enemy", "radius": 2, "damage": 4, "commander_damage": 2, "cost": 8, "set_id": "warfront",
"text": "对距目标格2格内的敌军造成4伤害。\n敌方指挥官承受2伤害。", "tag": "法术 · 大范围伤害"
}, {
"id": "last_hearth", "name": "天炉坠火", "short": "炉", "type": "spell", "effect": "formation", "target_side": "enemy", "radius": 2, "damage": 6, "commander_damage": 3, "fire": true, "cost": 10, "set_id": "warfront",
"text": "对距目标格2格内的敌军造成6火焰伤害。\n指挥官承受3点基础伤害，均受天气与赤烬首发影响。", "tag": "法术 · 十费压轴"
}, {
"id": "silt_snare", "name": "泥索暗结", "short": "索", "type": "trap", "effect": "trap", "trigger": "step", "amount": 0, "root": true, "draw": 1, "cost": 2, "set_id": "warfront",
"text": "伏设一空格。敌军主动踏入时\n截断移动并定身至本回合结束，你抽1张。", "tag": "陷阱 · 缚足抽牌"
}, {
"id": "fallback_horn", "name": "隐营回号", "short": "号", "type": "trap", "effect": "trap", "trigger": "attack", "amount": 2, "draw": 2, "cost": 4, "set_id": "warfront",
"text": "伏设于友军。下次实际承受普攻前，\n其获得2护盾，你抽2张。", "tag": "陷阱 · 受击补给"
}, {
"id": "tidal_oath", "name": "拒潮重印", "short": "印", "type": "trap", "effect": "trap", "trigger": "spell", "amount": 5, "draw": 1, "cost": 5, "set_id": "warfront",
"text": "伏设于友军。下次受敌方伤害法术或技能前，\n其获得5护盾，上限5，你抽1张。", "tag": "陷阱 · 重盾反术击"
}, {
"id": "open_wind", "name": "谷口穿风", "short": "风", "type": "environment", "effect": "weather", "weather": "tailwind", "duration": 4, "cost": 3, "set_id": "warfront",
"text": "全场进入疾风，持续4个行动回合。\n双方普通部队移动力增加1。", "tag": "天气 · 强化机动"
}, {
"id": "night_muster", "name": "诸营守夜", "short": "夜", "type": "environment", "effect": "weather", "weather": "lanterns", "duration": 6, "cost": 5, "set_id": "warfront",
"text": "全场进入灯夜，持续6个行动回合。\n双方新部署的普通部队额外获得1护盾。", "tag": "天气 · 入场护盾"
}, {
"id": "reed_roads", "name": "铺槛开道", "short": "路", "type": "environment", "effect": "roadwork", "cost": 5, "set_id": "warfront",
"text": "将目标格与相邻四格内可通行的陆地改为军道。\n桥梁保留。施法中心须在友军范围内。", "tag": "地形 · 成片铺路"
}, {
"id": "quay_lantern", "name": "堤灯侍医", "short": "医", "type": "unit", "kind": "healer", "cost": 1, "set_id": "afterglow",
"hp": 2, "atk": 1, "defense": 0, "move": 2, "range": 1, "fall": {"healing": 1},
"text": "阵亡时为相邻友军恢复1生命。\n保留医师的回合治疗。", "tag": "医师 · 退场治疗"
}, {
"id": "recall_writ", "name": "折回哨令", "short": "回", "type": "spell", "effect": "recall", "cost": 1, "set_id": "afterglow",
"text": "将一支友方普通部队收回手牌。\n解除其伏设，再部署需支付原费用。\n收回不会触发阵亡效果。", "tag": "法术 · 回收部队"
}, {
"id": "drawwire", "name": "割流暗线", "short": "线", "type": "trap", "effect": "trap", "trigger": "step", "amount": 0, "drain": 2, "cost": 1, "set_id": "afterglow",
"text": "伏设空格。敌军主动踏入时，\n失去最多2点本回合剩余法力。\n不打断移动。", "tag": "陷阱 · 地格耗法"
}, {
"id": "lantern_bearer", "name": "遗灯步卒", "short": "步", "type": "unit", "kind": "sword", "cost": 2, "set_id": "afterglow",
"hp": 5, "atk": 2, "defense": 0, "move": 2, "range": 1, "fall": {"draw": 1},
"text": "阵亡时抽1张牌，牌库为空则跳过。", "tag": "步兵 · 退场补给"
}, {
"id": "mink_watcher", "name": "芦汊巡弓", "short": "弓", "type": "unit", "kind": "archer", "cost": 2, "set_id": "afterglow",
"hp": 3, "atk": 2, "defense": 0, "move": 3, "range": 2, "entry": {"reveal": true},
"text": "部署时拆除落点和相邻四格的敌方陷阱。\n射程较短，可用高地补足。", "tag": "弓手 · 进场探路"
}, {
"id": "triage_writ", "name": "河口急救签", "short": "救", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 1, "healing": 1, "cleanse": true, "cost": 2, "set_id": "afterglow",
"text": "为目标格和相邻四格友军恢复1生命，\n解除定身。已用掉的行动保持原状。", "tag": "法术 · 群体解缚"
}, {
"id": "quiet_veil", "name": "湿帷潜护", "short": "帷", "type": "trap", "effect": "trap", "trigger": "spell", "amount": 1, "healing": 2, "cost": 2, "set_id": "afterglow",
"text": "伏设于友军。下次受敌方伤害法术或技能前，\n先恢复2生命，再获得1护盾，上限5。", "tag": "陷阱 · 术前急救"
}, {
"id": "ferry_pikeman", "name": "撑渡枪夫", "short": "枪", "type": "unit", "kind": "spear", "cost": 3, "set_id": "afterglow",
"hp": 5, "atk": 2, "defense": 2, "move": 2, "range": 1, "entry": {"guard": true}, "fall": {"shield": 1},
"text": "部署时援护相邻友军，至下个己方回合。\n阵亡时相邻友军各获得1护盾，上限5。", "tag": "枪兵 · 援护留盾"
}, {
"id": "split_sentence", "name": "裂签判罚", "short": "判", "type": "spell", "effect": "verdict", "amount": 2, "bonus": 2, "when": "wounded", "kill_draw": 1, "cost": 3, "set_id": "afterglow",
"text": "对一支敌方普通部队造成2伤害，目标已受伤时改为4。\n若因此消灭目标且牌库有牌，抽1张。", "tag": "法术 · 收割补牌"
}, {
"id": "salt_marker", "name": "盐封盾囊", "short": "囊", "type": "trap", "effect": "trap", "trigger": "attack", "amount": 2, "healing": 2, "cost": 3, "set_id": "afterglow",
"text": "伏设于友军。下次实际承受普攻前，\n先恢复2生命，再获得2护盾，上限5。", "tag": "陷阱 · 受击救援"
}, {
"id": "coast_drizzle", "name": "潮市斜雨", "short": "雨", "type": "environment", "effect": "weather", "weather": "rain", "duration": 3, "draw": 1, "cost": 3, "set_id": "afterglow",
"text": "全场进入暴雨，持续3个行动回合。\n双方火伤降低1，骑兵在军道外移动费用增加1。\n牌库有牌时抽1张。", "tag": "天气 · 暴雨补给"
}, {
"id": "willow_outlook", "name": "柳梢望手", "short": "弓", "type": "unit", "kind": "archer", "cost": 4, "set_id": "afterglow",
"hp": 5, "atk": 3, "defense": 0, "move": 2, "range": 3, "fall": {"draw": 1, "shield": 1},
"text": "阵亡时给相邻友军各1护盾，上限5。\n牌库有牌时抽1张。", "tag": "弓手 · 退场护阵"
}, {
"id": "ford_lock", "name": "沉链封渡", "short": "链", "type": "spell", "effect": "formation", "target_side": "enemy", "radius": 2, "root": true, "grounds": ["road", "bridge"], "cost": 4, "set_id": "afterglow",
"text": "距目标格2格内，站在军道或桥梁上的敌方普通部队\n下个己方回合无法移动。", "tag": "法术 · 路桥封锁"
}, {
"id": "mirror_anchor", "name": "镜锚回响", "short": "锚", "type": "trap", "effect": "trap", "trigger": "spell", "amount": 4, "draw": 1, "cost": 4, "set_id": "afterglow",
"text": "伏设于友军。下次受敌方伤害法术或技能前，\n获得4护盾，上限5，你抽1张。", "tag": "陷阱 · 反术补给"
}, {
"id": "quartermaster", "name": "潮册掌令", "short": "法", "type": "unit", "kind": "mage", "cost": 5, "set_id": "afterglow",
"hp": 6, "atk": 3, "defense": 0, "move": 2, "range": 2, "entry": {"draw": 1, "cleanse": true, "refresh_move": true},
"text": "部署时抽1张牌，解除相邻友军定身。\n已走未打、已就绪的相邻普通部队可再走。", "tag": "法师 · 补给换步"
}, {
"id": "return_manifest", "name": "归仓复籍", "short": "籍", "type": "spell", "effect": "recall", "draw": 2, "cost": 5, "set_id": "afterglow",
"text": "将一支友方普通部队收回手牌，解除其伏设。\n然后抽最多2张库中牌，手牌满则照常弃置。", "tag": "法术 · 回收补给"
}, {
"id": "lamplight_shift", "name": "三巡接灯", "short": "灯", "type": "environment", "effect": "weather", "weather": "lanterns", "duration": 4, "rally": {"healing": 2}, "cost": 5, "set_id": "afterglow",
"text": "全场灯夜持续4个行动回合，双方新兵各获1护盾。\n立即为己方指挥官及相邻友军恢复2生命。", "tag": "天气 · 灯夜救援"
}, {
"id": "moth_cavalry", "name": "灰蛾骑从", "short": "骑", "type": "unit", "kind": "cavalry", "cost": 6, "set_id": "afterglow",
"hp": 6, "atk": 5, "defense": 0, "move": 4, "range": 1, "entry": {"target_side": "enemy", "root": true},
"text": "部署时定身相邻敌方普通部队，\n使其下个己方回合无法移动。", "tag": "骑兵 · 进场留敌"
}, {
"id": "dew_wall", "name": "露槛排障", "short": "槛", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 2, "healing": 2, "shield": 1, "cleanse": true, "cost": 6, "set_id": "afterglow",
"text": "距目标格2格内，友军恢复2生命、获得1护盾，\n并解除定身。护盾上限5。", "tag": "法术 · 恢复阵线"
}, {
"id": "ash_notary", "name": "灰烬见证人", "short": "法", "type": "unit", "kind": "mage", "cost": 6, "set_id": "afterglow",
"hp": 6, "atk": 4, "defense": 0, "move": 2, "range": 3, "fall": {"healing": 2, "draw": 1},
"text": "阵亡时为相邻友军恢复2生命。\n牌库有牌时抽1张。", "tag": "法师 · 退场支援"
}, {
"id": "valley_reckoner", "name": "断铠清算", "short": "衡", "type": "spell", "effect": "verdict", "amount": 5, "bonus": 2, "when": "shielded", "shatter": true, "cost": 7, "set_id": "afterglow",
"text": "对一支敌方普通部队造成5伤害。\n若其有护盾，则先移除已有护盾，随后改为7伤害。", "tag": "法术 · 重甲破除"
}, {
"id": "kiln_wardens", "name": "赤窑护队", "short": "枪", "type": "unit", "kind": "spear", "cost": 7, "set_id": "afterglow",
"hp": 8, "atk": 4, "defense": 2, "move": 2, "range": 1, "entry": {"guard": true, "healing": 2, "shield": 1},
"text": "部署时援护相邻友军至下个己方回合。\n自身与相邻友军恢复2生命并获得1护盾，上限5。", "tag": "枪兵 · 进场稳阵"
}, {
"id": "terrace_relay", "name": "层台换哨", "short": "哨", "type": "spell", "effect": "formation", "target_side": "ally", "radius": 2, "refresh_move": true, "refresh_attack": true, "cost": 8, "set_id": "afterglow",
"text": "距目标格2格内，已攻击部队恢复攻击机会，已走未打且未定身的部队恢复移动。\n指挥官和新兵除外，不恢复技能次数。", "tag": "法术 · 阵线再动"
}, {
