extends "res://tests/test_campaign_playthrough_ui.gd"
## Uses a copy of an actual native ten-battle chapter-eight end save.
## The saved victory sequence is not regenerated by this short chapter test.
var plan: String = "joint"
var target_save: String = ""
var ninth_lines: int = 0
var ninth_choices: int = 0

func writer() -> void:
	var resume: Button = button(game.council, "继续战役")
	check(resume != null, "existing actual campaign save offers continue")
	if failures > 0: return
	await click(resume.get_global_rect().get_center())
	check(game.story_view.visible and game.campaign_session.encounter == null and game.campaign_session.campaign.completed.size() == 7 and game.campaign_session.campaign.story.graph.id == "chapter_08" and game.campaign_session.current().type == "end", "actual ten-battle save resumes at eighth ending")
	check(game.campaign_session.campaign.next_chapter().get("id") == "chapter_09", "new ninth is offered after real earlier wins")
	if failures > 0: return
	await click(button(game.story_view.actions, "进入").get_global_rect().get_center())
	check(game.campaign_session.campaign.completed.size() == 8 and game.campaign_session.current().line_id == "c09.dawn.01", "native chapter button enters ninth and saves all eight completed chapters")
	check(game.story_view.background_id == "scene_council_terrace" and game.story_view.Art.get_texture("scene_council_terrace") != null, "new council art is loaded for actual opening")
	if plan == "joint": await capture("v033-council-terrace")
	for step: int in range(260):
		var page: Dictionary = game.campaign_session.current()
		match page.type:
			"dialogue":
				ninth_lines += 1
				check(game.story_view.visible and game.story_view.text_body.text == page.text, "actual ninth paragraph is displayed before click")
				await click(game.story_view.actions.get_child(0).get_global_rect().get_center())
			"choice":
				ninth_choices += 1
				check(page.node == "governance" and page.options.size() == 3 and game.story_view.actions.get_child_count() == 3, "three governance options fit the real UI")
				if plan == "joint":
					DisplayServer.window_set_size(Vector2i(1008, 700)); await settle()
					await capture("v033-governance-small")
					DisplayServer.window_set_size(Vector2i(1296, 900)); await settle()
				var selected: int = -1
				for index: int in range(page.options.size()):
					if page.options[index].id == plan: selected = index
				check(selected >= 0, "declared governance plan is actually offered")
				if failures > 0: return
				await click(game.story_view.actions.get_child(selected).get_global_rect().get_center())
				check(game.campaign_session.campaign.story.state.flags.governance_plan == plan, "native choice persists its real plan")
				await capture("v033-" + plan + "-aftermath")
			"battle":
				check(false, "ninth ends before the separately authored tower battle")
				return
			"end":
				check(game.campaign_session.campaign.story.graph.id == "chapter_09" and game.campaign_session.campaign.next_chapter().is_empty() and ninth_choices == 1, "ninth terminates at its currently authored end page")
				check(game.campaign_session.save().ok, "final ninth page is saved without another battle result")
				await capture("v033-" + plan + "-ending")
				print("NINTH NATIVE WRITER: %d CHECKS | FAILURES: %d | PLAN: %s | DIALOGUES: %d | CHOICES: %d" % [checks, failures, plan, ninth_lines, ninth_choices])
				return
	check(false, "native ninth finishes before bounded page limit")

func reader() -> void:
	var resume: Button = button(game.council, "继续战役")
	check(resume != null, "independent process offers saved ninth")
	if failures > 0: return
	await click(resume.get_global_rect().get_center())
	check(game.story_view.visible and game.campaign_session.encounter == null and game.campaign_session.campaign.story.graph.id == "chapter_09" and game.campaign_session.current().type == "end", "independent process resumes ninth ending without a battle")
	check(game.campaign_session.campaign.completed.size() == 8 and game.campaign_session.campaign.story.state.flags.governance_plan == plan and game.campaign_session.campaign.next_chapter().is_empty(), "all prior chapters and chosen governance survive disk reload")
	await capture("v033-" + plan + "-resumed")
	print("NINTH NATIVE READER: %d CHECKS | FAILURES: %d | PLAN: %s" % [checks, failures, plan])

func run() -> void:
	create_timer(420).timeout.connect(func() -> void: push_error("ninth native UI timeout"); quit(2))
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--plan="): plan = arg.trim_prefix("--plan=")
	writing = OS.get_cmdline_user_args().has("--write")
	check(plan in ["joint", "split", "hold"] and (writing or OS.get_cmdline_user_args().has("--read")), "choose a supported plan and process mode")
	if failures > 0: quit(1); return
	target_save = "res://.tools/v033-native-chapter-nine-" + plan + ".json"
	check(FileAccess.file_exists(target_save), "real eighth-end save was copied to the plan-specific path")
	if failures > 0: quit(1); return
	game = MainScene.instantiate()
	game.deck_store = Store.new("res://.tools/v033-native-deck.json")
	game.campaign_session = Session.new(target_save)
	root.add_child(game); current_scene = game; await settle()
	if writing: await writer()
	else: await reader()
	game.queue_free(); await process_frame
	quit(0 if failures == 0 else 1)
